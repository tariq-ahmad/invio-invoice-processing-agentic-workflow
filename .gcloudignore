# gcloud source upload exclusions for Cloud Run --source builds.
# This file overrides .gitignore so the root `lib/` rule doesn't
# mistakenly exclude frontend/src/lib/ from the build context.

.git
.gitignore
.gcloudignore

# Python
.venv
__pycache__
**/__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.mypy_cache
.ruff_cache

# Node (don't upload node_modules or local build output — Docker rebuilds them)
frontend/node_modules
frontend/.vite
frontend/dist

# Test fixtures / dev-only files
tests/
*.local
.env
.env.*
my_env.tfvars
.terraform*
.agents-cli-scripts/
.google-agents-cli/
deployment/

# Eval traces/grade reports — can grow to tens of MB, no reason to upload them
artifacts/

# Secrets — never upload to the build context
client_secret_*.json
*_token.json

# Claude Code worktrees — contain extra Dockerfiles that confuse Cloud Build
# auto-detection when uploaded in the source context.
.claude/

# IDE
.vscode
.idea
.DS_Store
Thumbs.db
