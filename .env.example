# Copy to .env and fill in your own values (never commit the real .env — it's
# already gitignored). See ENV_SETUP.md for the full explanation of each var.
# Local dev: uv run --env-file .env agents-cli playground

# ── Required — fill in with YOUR OWN values ─────────────────────────────────

# GCP project used by the deployment scripts (deployment/*.sh).
GCP_PROJECT_ID=

# AgentMail inbox this deployment monitors for invoices, e.g. invoices@agentmail.to.
# Create it in the AgentMail console first.
AGENTMAIL_INBOX_ID=

# AgentMail API key. Local dev reads it directly; deploy-infra.sh stores it in
# Secret Manager and the Cloud Run service reads it from there.
AGENTMAIL_API_KEY=

# Fallback recipient for vendor-rejection drafts when the vendor's own address
# can't be determined from the invoice email.
VENDOR_FALLBACK_EMAIL=

# ── Required only for a live Cloud Run deployment ───────────────────────────

# Your deployed Cloud Run service URL. Handy for GET <url>/intake/status; also
# worth setting as AGENT_CARD_URL below once you know it.
SERVICE_URL=

# Public URL of your deployed service, published in the A2A agent card
# (app/agent.json ships with a placeholder). Format: https://<service-url>/a2a/app
AGENT_CARD_URL=

# ── Optional — safe defaults, override only to customize ────────────────────

# GEMINI_MODEL_SCREENING=gemini-3.5-flash-lite
# GEMINI_MODEL_EXTRACTION=gemini-3.8-flash
# GEMINI_MODEL_DRAFT_EMAIL=gemini-3.5-flash-lite
# GEMINI_MODEL_EXTRACTION_LITE=gemini-3.5-flash-lite
# GEMINI_MODEL_EXTRACTION_PRO=gemini-3.1-pro-preview

# AP policies (HITL threshold, FX, ...) and PO master data live in Firestore.
# CONFIG_SOURCE=local serves the in-code defaults instead (offline dev, no GCP creds).
# CONFIG_SOURCE=firestore
# FIRESTORE_DATABASE=(default)
# FIRESTORE_POLICIES_COLLECTION=policies
# FIRESTORE_PURCHASE_ORDERS_COLLECTION=purchase_orders
# FIRESTORE_POSTED_INVOICES_COLLECTION=posted_invoices
# POLICY_CACHE_TTL_SECONDS=60

# Model Armor screening of invoice emails/attachments, extracted text and the
# rejection-email draft (app/model_armor.py). Off by default; see ENV_SETUP.md.
# MODEL_ARMOR_ENABLED=false
# MODEL_ARMOR_TEMPLATE=invoice_processing_model_armor
# MODEL_ARMOR_LOCATION=us-west1
# MODEL_ARMOR_ENFORCE=true            # false = inspect-only: record verdicts, never block
# MODEL_ARMOR_FAIL_CLOSED=true        # no verdict (API error / >4 MB file) stops the invoice
# MODEL_ARMOR_INBOUND_IGNORE_FILTERS=sdp   # inbound matches recorded but not acted on
# MODEL_ARMOR_SCAN_IMAGES=false       # JPEG/PNG scanning fails on the us-west1 template; see ENV_SETUP.md
# MODEL_ARMOR_TIMEOUT_S=15

# PII masking of the email text the screening/extraction LLMs read, using the
# de-identified text the Model Armor template returns (advanced Sensitive Data
# Protection: DLP inspect + de-identify templates). What is masked is set in those
# DLP templates. Needs MODEL_ARMOR_ENABLED. The attachment itself is NOT masked.
# Off by default; failures follow MODEL_ARMOR_FAIL_CLOSED. See ENV_SETUP.md.
# PII_MASKING_ENABLED=false

# ENABLE_MEMORY=false
# MEMORY_PRECEDENT_MIN=2
# MEMORY_AGENT_ENGINE_ID=
# MEMORY_LOCATION=us-west1

# EXTRACTION_GCS_BUCKET=
# MAX_LINE_ITEM_CALLS=8
# LINE_ITEM_CONTINUATION_ANCHOR_K=3
# EXTRACTION_DYNAMIC_MODEL_TIERING=true

# AGENTMAIL_SEED_INBOX_ID=   # tests/fixtures/seed_inbox.py: sender inbox (default: self-send)
# ENABLE_A2UI=true
# ALLOW_ORIGINS=
# INVOICE_TRACE_VERBOSE=false

# ── Cloud Run only — set automatically by deployment/deploy-infra.sh ────────
# (listed here for reference; you shouldn't need to set these by hand)

# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-west1
# GOOGLE_GENAI_USE_VERTEXAI=True
# AGENTMAIL_API_KEY_SECRET=projects/<project>/secrets/agentmail-api-key/versions/latest
# AGENTMAIL_INTAKE_ENABLED=true
# AGENTMAIL_CATCHUP_MINUTES=30
# LOGS_BUCKET_NAME=

# ── Frontend (Vite) — set in frontend/.env if needed ────────────────────────
# VITE_ADK_BASE=
# VITE_ADK_TARGET=http://localhost:8000
